# Postgres (Neon)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_URL=http://localhost:4200

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=caffeine
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_URL=               # optional, only if bucket is publicly readable

# Modal services (filled in once deployed)
MODAL_SIMULATIONS_URL=
MODAL_NINJA_URL=
MODAL_MODEL_PARSER_URL=
# Shared bearer token between web and model-parser (must match the value
# in the Modal `caffeine-model-parser` secret)
MODEL_PARSER_TOKEN=
# Shared bearer token for the simulations service (must match the value
# in the Modal `caffeine-simulations` secret)
SIMULATIONS_TOKEN=
